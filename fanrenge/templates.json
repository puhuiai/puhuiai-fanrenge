{
  "版本": "fanrenge-templates/1.1",
  "说明": "行业模板库（【行业→场景→任务】三级目录）+ 综合模具（_模具：所有任务统一套用）+ 行业标准（_行业包：只写差异）。模板不是一段固定提示词，而是带必填/可选/约束/输出规范的结构化表单",
  "更新记录": [
    {
      "日期": "2026-09-24",
      "版本": "fanrenge-templates/1.1",
      "变更": "新增 _模具（综合模具 8 环节）与 _行业包（13 个行业标准，按需含子域）；13 个场景模板降重：通用内容移入模具、行业内容移入行业包，场景只留差异；清理不可测指标（≥95%/≤85% 类）"
    }
  ],
  "_模具": {
    "版本": "mold/1.0",
    "说明": "综合模具：所有任务统一套用；行业标准只写差异（不得复制本段内容）",
    "环节": [
      "目标确认",
      "环境确认",
      "工具确认",
      "需求澄清",
      "拆步",
      "约束",
      "验收",
      "下游复盘"
    ],
    "steps_base": [
      "确认要做什么、给谁用、最终要什么形式",
      "先查同行业历史任务（前置经验检索）：上次同类任务怎么做、踩过什么坑，能复用的直接带上",
      "确认环境：在哪个目录/平台做，手上已有什么材料和账号，以及做完拿什么自测（跑测试/打开页面/截图/录屏）",
      "确认工具：用什么工具完成，没有该工具时的替代路径",
      "澄清需求：把没说清的关键参数问明白",
      "把任务拆成可执行步骤（每步都能单独验收）"
    ],
    "steps_tail": [
      "逐项产出后对照限制条件自检一遍",
      "交独立复核 → 交付 → 复盘留档"
    ],
    "questions_base": [
      {
        "slot": "完成标准",
        "问法": "这件事做到什么程度你就算满意了？",
        "适用": "自由模式"
      },
      {
        "slot": "现有材料",
        "问法": "你手上现在有什么材料？（产品图、文案、已有代码…没有就说没有）",
        "适用": "自由模式"
      },
      {
        "slot": "交付形式",
        "问法": "最后你想要什么形式？（文本 / 图片 / 可运行的东西 / 链接）",
        "适用": "不追问"
      }
    ],
    "rules_base": [
      "不谎报没做到的事；没出结果就说没出结果",
      "危险动作（删除、对外发布、花钱、改账号）先停下来说明，等人确认",
      "只做任务范围内的事，顺手改动一律不做，发现的其他问题写在报告里",
      "对外内容不得使用绝对化用语（最、第一、100%、国家级等）与虚假承诺",
      "涉及个人信息与客户资料时不得外泄，不得用于本任务之外的用途"
    ],
    "acceptance_base": [
      "交付物完整可用（文件/字段齐全）",
      "至少留两类证据（命令输出 / 测试红绿 / 截图录屏 / 链接）",
      "换个环境按步骤能复现同样结果"
    ],
    "output_spec_base": [
      "可直接执行的步骤清单",
      "交付物清单"
    ],
    "downstream_base": [
      "执行 Agent",
      "独立复核 Agent（交叉验收）",
      "复盘留档"
    ],
    "锚点": {
      "前置": "环境",
      "中段": "拆成可执行步骤",
      "后置": "自检"
    },
    "自测手段_base": [
      "跑一遍测试或校验步骤，把原始输出留档（不是口头说通过）",
      "打开成品实际用一遍（页面截图 / 文件打开 / 音频试听）",
      "对照「限制条件」逐条自检，把不达标的地方写在报告里"
    ],
    "预案_base": [
      "信息不全/没材料 → 先用现有信息出草稿，把缺的项标出来，不要卡住空等",
      "工具没有或不可用 → 走行业标准里「没有时」的替代路径，别擅自换方案",
      "做完发现方向不对 → 停下来说清哪里不对，给 2 个备选再继续"
    ]
  },
